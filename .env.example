# VORTEX SI — environment template (100% Free-Tier Architecture)
#
# Copy to `.env` for local runs. `.env` is git-ignored. Never commit real
# secrets. Generate `VORTEX_SECRET_KEY` and `VORTEX_ADMIN_TOKEN` with:
#   node scripts/generate-secrets.mjs

# --- Runtime identity -------------------------------------------------------
NODE_ENV=development
VORTEX_ROLE=worker                      # worker | relay | all
VORTEX_INSTANCE_LABEL=local
VORTEX_LOG_LEVEL=info                   # debug | info | warn | error

# --- Database (Supabase Free) — SERVER-ONLY SECRET -------------------------
# DATABASE_URL is the Supabase Session Pooler URI. Copy the ENTIRE string from
#   Supabase Dashboard -> Connect -> Connection string -> Session pooler
# Format:
#   postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# where <pooler-host> looks like `aws-<index>-<region>.pooler.supabase.com`.
# Copy the host from the dashboard: the aws-0/aws-1 index and region CANNOT be
# derived from the project ref. Port 5432 is session mode (required); port 6543
# is the transaction pooler and is rejected because VORTEX SI relies on
# session-level advisory locks and multi-statement transactions.
DATABASE_URL=
# Optional IPv6 fallback. Only used when DATABASE_URL is empty. On the Free plan
# `db.<project-ref>.supabase.co` is IPv6-only and cannot be reached from
# IPv4-only GitHub Actions runners, so do not use it there.
DATABASE_URL_DIRECT=
# Public (non-secret) project ref, used to verify that the pooler username
# `postgres.<ref>` belongs to this project.
SUPABASE_PROJECT_REF=nohewrljcqimotoaemyg
# Owner opt-in: allow the IPv6-only direct endpoint on an IPv6-capable runner.
VORTEX_DB_ALLOW_DIRECT_CONNECTION=false
VORTEX_DB_POOL_MAX=4
# Local development fallback only: set true to use embedded PGlite when DATABASE_URL is empty.
VORTEX_USE_EMBEDDED_DB=false
VORTEX_DB_REQUIRED=false

# --- Encryption & admin plane — SERVER-ONLY SECRETS -------------------------
# Required in production: >= 32 bytes (64 hex chars or 44 base64 chars).
# Encrypts provider API keys at rest (AES-256-GCM) in `provider_keys`.
VORTEX_SECRET_KEY=
# Required only when running the optional HTTP relay (`VORTEX_ROLE=relay`).
VORTEX_ADMIN_TOKEN=

# --- Market data provider (Twelve Data Free Tier) — SERVER-ONLY SECRET ------
VORTEX_PROVIDER=twelvedata              # twelvedata | simulated
# Up to four server-only keys, encrypted with VORTEX_SECRET_KEY and synced to
# the database key pool by `npm run job:run`. Fallback is bounded and limited
# to classified key/rate failures. Keys on one Twelve Data account still share
# its account quota; never use rotation to evade plan limits.
TWELVEDATA_API_KEY=
TWELVEDATA_API_KEY_2=
TWELVEDATA_API_KEY_3=
TWELVEDATA_API_KEY_4=
VORTEX_PROVIDER_BASE_URL=https://api.twelvedata.com
VORTEX_PROVIDER_RPM_PER_KEY=8
VORTEX_PROVIDER_RPD_PER_KEY=800
VORTEX_PROVIDER_HEADROOM_PERCENT=15
VORTEX_PROVIDER_TIMEOUT_MS=10000
VORTEX_PROVIDER_MAX_ATTEMPTS=2
VORTEX_MAX_CANDLE_AGE_SECONDS=90

# --- Instrument universe (conservative Free-Tier default) -------------------
# Twelve Data Free allows 800 requests/day (680 usable after 15% safety headroom).
# 2 pairs polled every 5 minutes on GitHub Actions uses <= 576 requests/day.
VORTEX_PAIRS=EUR/USD,GBP/USD

# --- Engine thresholds ------------------------------------------------------
VORTEX_SIGNAL_HORIZON_SECONDS=300
VORTEX_SIGNAL_COOLDOWN_SECONDS=900
VORTEX_MIN_CONFIDENCE=0.60
VORTEX_MIN_CALIBRATED_WIN_PROB=0.55
VORTEX_MIN_EXPECTANCY_PIPS=0.25
VORTEX_SPREAD_MULTIPLIER_LIMIT=2.0

# --- Self-learning ----------------------------------------------------------
VORTEX_LEARNING_ENABLED=true
VORTEX_TRAIN_MIN_SAMPLES=200
VORTEX_MODEL_ARTIFACT_DIR=./artifacts

# --- Telegram delivery — SERVER-ONLY SECRET ---------------------------------
VORTEX_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_PRIMARY=
TELEGRAM_CHANNEL_SECONDARY=
# Must remain false in production so simulated candles can never reach Telegram.
VORTEX_ALLOW_SYNTHETIC_SIGNALS=false

# --- Optional local HTTP relay ----------------------------------------------
PORT=8787
VORTEX_HTTP_HOST=127.0.0.1
VORTEX_CORS_ORIGIN=http://localhost:5173

# --- Dashboard build-time variables (GitHub Pages — PUBLIC) -----------------
# Option A (Recommended Free-Tier): read-only Supabase `public_*` views.
# NEVER pass the Supabase `service_role` / `sb_secret_` key here; use only the
# public `anon` / publishable key. Migration 0007 revokes all base-table access
# from `anon` and grants SELECT only on secret-free `public_*` views.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Option B: static status snapshot (`./snapshot.json`) built by GitHub Actions.
VITE_DATA_SOURCE=
# Option C: optional HTTP relay URL.
VITE_RELAY_URL=
VITE_BASE_PATH=./
# Optional developer opt-in: extra Host headers the local dev server may serve
# (comma separated, a leading dot allows subdomains). Empty keeps Vite's default
# host protection. Example: VITE_DEV_ALLOWED_HOSTS=.example.dev
VITE_DEV_ALLOWED_HOSTS=
