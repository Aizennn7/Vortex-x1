# ============================================================================
# VORTEX SI — environment template
# Copy to .env and fill in. NEVER commit real values.
# Values marked (public) may be exposed to the browser; everything else is
# server-side only and is asserted against by `npm run test:worker`.
# ============================================================================

# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Process role — one codebase, two deployed services
#   all    = relay + scheduler in one process (local development default)
#   relay  = HTTP surface only; never schedules work  -> public web service
#   worker = scheduler only; binds no port            -> background worker
# Both roles share the database, the job slots and the scheduler lease, so
# running either twice is still safe. `--role=relay|worker` on the command
# line overrides this variable.
# ---------------------------------------------------------------------------
VORTEX_ROLE=all
# Label written to worker_heartbeats.instance_label, so several workers stay
# distinguishable in the control centre.
VORTEX_INSTANCE_LABEL=worker
# Apply packages/db/migrations at boot. Leave false in production: migrations
# are a deliberate operator action (`npm run migrate`), not a restart side effect.
VORTEX_AUTO_MIGRATE=false

# Public origin of the web UI (used for CORS + Telegram/deep links).
# (public)
VORTEX_PUBLIC_WEB_URL=https://aizennn7.github.io/Vortex-x1

# Bearer token protecting the privileged /admin/* relay routes.
# Generate with: openssl rand -hex 32
VORTEX_ADMIN_TOKEN=

# Base64 32-byte master key used to encrypt provider keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
VORTEX_SECRET_KEY=

# CORS allow-list, comma separated. Empty = same-origin only.
VORTEX_CORS_ORIGINS=https://aizennn7.github.io

# ---------------------------------------------------------------------------
# Database (Supabase Postgres connection string)
# Prefer the pooled connection string (port 6543) for the worker.
# ---------------------------------------------------------------------------
DATABASE_URL=
# Optional direct connection used by migrations / schema tooling (port 5432).
DATABASE_URL_DIRECT=
# Fail fast if the database is unreachable at boot (true in production).
VORTEX_DB_REQUIRED=true
# Development/CI only: run against an embedded Postgres instead of DATABASE_URL.
VORTEX_USE_EMBEDDED_DB=false

# ---------------------------------------------------------------------------
# Market data provider (Twelve Data)
# DO NOT put keys here. Add them through the control center or the
# POST /admin/keys route so they are stored encrypted in the database.
# ---------------------------------------------------------------------------
VORTEX_PROVIDER=twelvedata
VORTEX_PROVIDER_BASE_URL=https://api.twelvedata.com
# Hard ceilings that mirror YOUR Twelve Data plan (requests/minute and
# requests/day per key). The pool respects these — it never bypasses them.
# Ingestion issues roughly one request per pair per minute, so a plan of
# 8 credits/min and 800/day supports roughly 2 pairs on a continuous run.
# When the budget is gone the worker stops calling the provider and reports
# `exhausted`; it does not retry into the limit.
VORTEX_PROVIDER_RPM_PER_KEY=8
VORTEX_PROVIDER_RPD_PER_KEY=800
# Reserved headroom kept for interactive/backfill requests (percent).
VORTEX_PROVIDER_HEADROOM_PERCENT=15
# Grace period after a quota refusal before the next attempt (seconds).
VORTEX_PROVIDER_QUOTA_GRACE_SECONDS=60
VORTEX_PROVIDER_TIMEOUT_MS=12000
VORTEX_PROVIDER_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Signal engine
# ---------------------------------------------------------------------------
# Currency pairs to ingest and score. More pairs means proportionally more
# provider credits per minute.
VORTEX_PAIRS=EUR/USD,GBP/USD
VORTEX_SCAN_CADENCE_MINUTES=5
VORTEX_PUBLISH_LEAD_SECONDS=60
VORTEX_SIGNAL_HORIZON_SECONDS=60
# Maximum signals published per 5-minute slot (1-5).
VORTEX_MAX_SIGNALS_PER_SLOT=2
VORTEX_MIN_CONFIDENCE=0.62
VORTEX_MIN_RR=1.2
VORTEX_MAX_SPREAD_PIPS=2.5
VORTEX_MAX_CANDLE_AGE_SECONDS=90
VORTEX_PAPER_STARTING_BALANCE=10000
VORTEX_PAPER_RISK_PERCENT=0.5

# ---------------------------------------------------------------------------
# Telegram (server-side only)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Destination channels, comma separated @channel or -1001234567890 ids.
TELEGRAM_CHANNEL_PRIMARY=
TELEGRAM_CHANNEL_SECONDARY=
VORTEX_TELEGRAM_ENABLED=false
# Delivery of signals derived from the SIMULATED feed. Leave false unless you are
# running a demo you have labelled as such — the worker refuses to publish these
# to a real audience otherwise.
VORTEX_ALLOW_SYNTHETIC_SIGNALS=false

# ---------------------------------------------------------------------------
# Learning pipeline
# ---------------------------------------------------------------------------
VORTEX_LEARNING_ENABLED=true
VORTEX_TRAIN_MIN_SAMPLES=200
VORTEX_TRAIN_CRON=0 3 * * *
VORTEX_MODEL_PROMOTION_MIN_ACCURACY=0.55
VORTEX_MODEL_PROMOTION_MIN_AUC=0.55
VORTEX_MODEL_MAX_LOG_LOSS_REGRESSION=0.02

# ---------------------------------------------------------------------------
# Worker coordination
# ---------------------------------------------------------------------------
# Defaults to <hostname>-<pid> when empty; set it to a stable name when running
# more than one worker so heartbeats are attributable.
VORTEX_WORKER_ID=
VORTEX_HEARTBEAT_SECONDS=30
VORTEX_HEARTBEAT_STALE_SECONDS=120
# Also the TTL of the singleton scheduler lease: a second worker instance stays
# in standby (no cycles, no heartbeat) until this expires or the holder stops.
VORTEX_JOB_LOCK_TTL_SECONDS=300
# Where nightly training writes model artifacts. Ephemeral disks lose them;
# the database keeps the promoted model either way.
VORTEX_ARTIFACT_DIR=artifacts
# Retention windows used by the maintenance job (days).
VORTEX_CANDLE_RETENTION_DAYS=45

# ---------------------------------------------------------------------------
# Dashboard build (apps/web) — set at build time, read by the static bundle
# ---------------------------------------------------------------------------
# Public origin of the deployed relay, e.g. https://vortex-si-relay.onrender.com
# On GitHub Pages this is REQUIRED (the static site cannot proxy /api). It is a
# repository variable (VITE_RELAY_URL), never a hard-coded URL in the source.
# Leave empty only to call the relay on the same origin the site is served from.
VITE_RELAY_URL=
# Public base path of the site. './' works for a GitHub Pages project site at
# https://<owner>.github.io/<repo>/. Set '/' only for a domain root.
VITE_BASE_PATH=./
# Dev-server only: where `npm run dev:web` proxies /api and /health.
VITE_DEV_RELAY=http://127.0.0.1:8787
